# -- Allocation engine (which managed account receives a deposit / pays a withdrawal) --
#    off    - the engine is never called. A deposit waits in ACCOUNT_REQUESTED for an Admin
#             and a withdrawal carries no payout account: exactly the behaviour that existed
#             before allocation was built. This is the safe state for an environment whose
#             account daily limits and opening balances are not ready yet.
#    shadow - the engine runs and journals the decision it WOULD have made, then discards it.
#             Nothing is assigned, no payout leg is written and no capacity is consumed, so a
#             shadow run can be compared against the Admin's own choices without affecting them.
#    on     - the engine decides.
#    Only the exact word "on" starts it. "true", "1" and "yes" all read as off, deliberately.
ALLOCATION_ENGINE_MODE=off
